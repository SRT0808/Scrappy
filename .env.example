# Local web/API: these four are required by npm run dev (server only, no VITE_ prefix).
# Leave VERCEL unset locally. SESSION_SECRET must contain at least 32 UTF-8 bytes.
ACCESS_KEY=
SESSION_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local migration setup only; never add these to Vercel or the browser.
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=
# Production only: local readings use .venv Python, without GitHub dispatch.
GITHUB_TOKEN=
GITHUB_REPO=
# Notifications: required by the scraper and Settings API (local and Vercel); server-only.
# Long random private topic (at least 24 URL-safe characters).
NTFY_TOPIC=
GMAIL_USER=
# Google app password with two-step verification, not the account password.
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=
HEALTHCHECK_URL=
# Vercel Production: ACCESS_KEY, SESSION_SECRET, SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY, GITHUB_TOKEN, GITHUB_REPO and all four notification values.
# GitHub Secrets: both Supabase values, all four notification values and HEALTHCHECK_URL.
# HEALTHCHECK_URL belongs only in Actions; VERCEL is supplied automatically by Vercel.
# Optional trusted local HTTPS certificate paths for physical-phone PWA acceptance.
# Set both together; leave empty to use the existing self-signed certificate.
LOCAL_HTTPS_CERT=
LOCAL_HTTPS_KEY=
