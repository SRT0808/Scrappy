# Local web/API: these four are required by npm run dev (server only, no VITE_ prefix).
# Leave VERCEL unset locally. SESSION_SECRET must contain at least 32 UTF-8 bytes.
ACCESS_KEY=
SESSION_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local migration setup only; never add these to Vercel or the browser.
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=
# Optional alternatives worker only: dedicated NOINHERIT SQL login, member only of
# service_role, no ownership/elevated attributes. Never reuse migration credentials.
# No URL query options; TLS verifies the server certificate (optional PEM CA below).
# Authorized local runtime/Actions only; never Vercel, browser or VITE_ variables.
# These values do not activate the worker or install a Vite callback.
PURCHASE_DATABASE_URL=
PURCHASE_DATABASE_CA=
PURCHASE_APP_ORIGIN=
# Actions repository VARIABLE (not a secret): leave unset/false until stage 5.
# Only the explicit Actions CLI reads this flag; npm run dev stays disconnected.
PURCHASE_WORKER_ENABLED=false
# Production only: local readings use .venv Python, without GitHub dispatch.
GITHUB_TOKEN=
GITHUB_REPO=
# Notifications: required by the scraper and Settings API (local and Vercel); server-only.
# Long random private topic (at least 24 URL-safe characters).
NTFY_TOPIC=
GMAIL_USER=
# Google app password with two-step verification, not the account password.
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=
HEALTHCHECK_URL=
# Local operator access for the authorized external scheduler acceptance only.
# Keep both values private; never provide them to the browser or GitHub job.
CRONJOB_API_KEY=
# Read-only project API key for independent heartbeat receipt verification.
HEALTHCHECKS_API_KEY=
# Vercel Production: ACCESS_KEY, SESSION_SECRET, SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY, GITHUB_TOKEN, GITHUB_REPO and all four notification values.
# GitHub Secrets: both Supabase values, all four notification values and HEALTHCHECK_URL.
# Stage 5 only: PURCHASE_DATABASE_URL, optional PURCHASE_DATABASE_CA, PURCHASE_APP_ORIGIN.
# HEALTHCHECK_URL belongs only in Actions; VERCEL is supplied automatically by Vercel.
# Optional trusted local HTTPS certificate paths for physical-phone PWA acceptance.
# Set both together; leave empty to use the existing self-signed certificate.
LOCAL_HTTPS_CERT=
LOCAL_HTTPS_KEY=
