{
  "name": "scrappy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file=.env node_modules/vite/bin/vite.js",
    "dev:pwa": "npm run build && npm run dev -- --mode pwa",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test:web": "vitest run",
    "test:auth": "tsc && node --test .scrappy/api-build/tests/auth.test.js",
    "test:dev": "tsc && node --test .scrappy/api-build/tests/local-dev.test.js",
    "test:readings:local": "tsc && node --test .scrappy/api-build/tests/local-readings.test.js",
    "test:auth:sql": "node --env-file=.env tests/auth-sql.mjs",
    "test:lists": "tsc && node --test .scrappy/api-build/tests/lists.test.js",
    "test:lists:sql": "node --env-file=.env tests/lists-sql.mjs",
    "test:products": "tsc && node --test .scrappy/api-build/tests/products.test.js",
    "test:products:sql": "node --env-file=.env tests/products-sql.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nodemailer": "^10.0.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  }
}
